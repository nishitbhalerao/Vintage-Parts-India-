{
  "version": 2,
  "name": "vintage-parts-backend",
  "buildCommand": "npm install --prefix server",
  "outputDirectory": "server",
  "env": {
    "MONGODB_URI": "@mongodb_uri",
    "JWT_SECRET": "@jwt_secret",
    "NODE_ENV": "production"
  },
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  }
}
